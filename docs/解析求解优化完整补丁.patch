+ it('cancels positive formal constants and evaluates written special angles exactly',()=>{expect(solve(['pi*x=12*pi'],['x']).candidates[0].values).toEqual([12]);expect(solve(['x=pi/pi'],['x']).candidates[0].values).toEqual([1]);expect(solve(['x=sin(pi/6)'],['x']).candidates[0].values).toEqual([0.5]);expect(solveExactSystem(['x=pi'],['x']).reasonCode).toBe('unsupported');});
